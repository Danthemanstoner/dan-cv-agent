{
  "name": "dan-cv-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Facts API (REST + MCP) behind Agent Dan, the AI guide for Dan Stoner's CV site, built on Agentplace.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch scripts/dev.ts",
    "start": "tsx scripts/dev.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:cv": "tsx scripts/build-cv.ts",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@neondatabase/serverless": "1.0.2",
    "express": "5.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/node": "24.9.1",
    "@types/supertest": "6.0.3",
    "supertest": "7.1.4",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "5.1.2"
  }
}
